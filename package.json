{
  "name": "wecom-electron",
  "version": "0.1.0",
  "private": true,
  "description": "WeCom DM Sync desktop app (Electron shell around the FastAPI backend).",
  "main": "dist-electron/main.js",
  "scripts": {
    "electron:dev": "tsc -p electron/tsconfig.json && cross-env-shell NODE_ENV=development \"electron .\"",
    "electron:build": "pnpm --filter ./frontend build && tsc -p electron/tsconfig.json",
    "electron:start": "tsc -p electron/tsconfig.json && electron .",
    "electron:pack": "pnpm electron:build && electron-builder",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tree-kill": "^1.2.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
